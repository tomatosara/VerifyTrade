{
  "name": "@verifytrade/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm run dev:api",
    "dev:api": "tsx watch -r tsconfig-paths/register src/server.ts",
    "dev:compose:up": "docker compose -f ../../docker-compose.db.yml up -d",
    "dev:compose:down": "docker compose -f ../../docker-compose.db.yml down -v",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:generate": "pnpm typeorm -- migration:generate src/database/migrations/$npm_config_name -d src/database/data-source.ts",
    "migration:generate": "pnpm typeorm -- migration:generate src/database/migrations/$npm_config_name -d src/database/data-source.ts",
    "seed": "pnpm db:seed",
    "typeorm:migrate:run": "tsx -r tsconfig-paths/register src/database/cli/run-migrations.ts",
    "typeorm:migrate:revert": "tsx -r tsconfig-paths/register src/database/cli/revert-migrations.ts",
    "db:seed": "tsx -r tsconfig-paths/register src/database/seed/seed.ts",
    "db:seed:test": "cross-env SEED_PROFILE=test tsx -r tsconfig-paths/register src/database/seed/seed.ts",
    "db:reset": "pnpm typeorm:migrate:revert -- --all && pnpm typeorm:migrate:run && pnpm db:seed",
    "openapi": "tsoa spec-and-routes --configuration tsoa.json",
    "openapi:print": "curl -s http://localhost:4000/openapi.json | jq '.'"
  },
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^4.0.2",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-http": "^8.6.0",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-dist": "5.11.0",
    "swagger-ui-express": "5.0.1",
    "tslib": "^2.6.2",
    "tsoa": "^6.3.2",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.4.0",
    "@tsoa/runtime": "^6.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.24",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.8",
    "@types/swagger-ui-express": "^4.1.5",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "openapi-types": "^12.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
