{
  "entryFile": "src/server.ts",
  "controllerPathGlobs": [
    "src/modules/**/controller/*.controller.ts"
  ],
  "noImplicitAdditionalProperties": "throw-on-extras",
  "spec": {
    "outputDirectory": ".",
    "specFileBaseName": "openapi",
    "specVersion": 3,
    "basePath": "/api/v1",
    "schemes": [
      "https",
      "http"
    ],
    "tags": [
      {
        "name": "TradeForm",
        "description": "Trade form marketplace operations"
      }
    ],
    "name": "VerifyTrade API",
    "description": "Digital identity trading platform API",
    "version": "1.0.0",
    "securityDefinitions": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token issued by /auth/login-by-verifier; send as Authorization: Bearer <token>"
      }
    }
  },
  "routes": {
    "routesDir": "src/http",
    "basePath": "/api/v1",
    "middleware": "express",
    "authenticationModule": "src/http/authentication.ts"
  },
  "security": {
    "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT",
      "description": "Access token issued by /auth/login-by-verifier; send as Authorization: Bearer <token>"
    }
  }
}
