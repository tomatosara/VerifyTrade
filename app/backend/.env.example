# Copy this file to app/backend/.env and edit as needed. Never commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DEV_HTTPS=false
DEV_TLS_CERT_PATH=certs/dev.crt
DEV_TLS_KEY_PATH=certs/dev.key

# Replace before running in production. Use a long random string!
JWT_SECRET=__JWT_SECRET__
PLATFORM_JWT_SECRET=__PLATFORM_JWT_SECRET__
JWT_ISSUER=verifytrade
JWT_AUDIENCE=verifytrade-users
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__

SWAGGER_PATH=/docs
BASE_PATH=/
API_BASE_URL=http://localhost:3000
TRUST_PROXY=0
SWAGGER_TITLE=Trading Platform API
SWAGGER_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=__DB_NAME__
# DATABASE_URL=postgres://__DB_USER__:__DB_PASSWORD__@localhost:5432/__DB_NAME__
COMPOSE_DB_HOST=db
COMPOSE_DB_PORT=5432

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
SHARE_URL_BASE=https://app.example.com/join
ALLOWED_META_KEYS=chain_tx_hash,vc_user2
PERSIST_STRATEGY=db
UID_TTL_MINUTES=60
VC_MIN_CRITERIA={"requiredClaims":["kyc_passed"]}
CHAIN_RPC_URL=
CHAIN_WALLET_KEY=
LOG_LEVEL=info
REQUIRE_VC_FOR_CREATOR=false

# 外部 sandbox
VERIFIER_BASE=https://verifier-sandbox.wallet.gov.tw
VERIFIER_TOKEN=__VERIFIER_TOKEN__

ISSUER_BASE=https://issuer-sandbox.wallet.gov.tw
ISSUER_TOKEN=__ISSUER_TOKEN__

VP_IDCARD=00000000_login_verify
VP_TRADEFORM=00000000_trade_verify
