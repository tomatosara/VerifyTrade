NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SWAGGER_PATH=/docs
BASE_PATH=/
DEV_HTTPS=false
API_BASE_URL=http://localhost:3000
TRUST_PROXY=0
SWAGGER_TITLE=Trading Platform API
SWAGGER_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app_db
# DATABASE_URL=postgres://app:app@localhost:5432/app_db
COMPOSE_DB_HOST=db
COMPOSE_DB_PORT=5432

JWT_SECRET=dev-secret-change-me
PLATFORM_JWT_SECRET=platform-secret-change-me
JWT_ISSUER=verifytrade
JWT_AUDIENCE=verifytrade-users

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
SHARE_URL_BASE=https://app.example.com/join
ALLOWED_META_KEYS=chain_tx_hash
PERSIST_STRATEGY=db
UID_TTL_MINUTES=60
VC_MIN_CRITERIA={}
CHAIN_RPC_URL=
CHAIN_WALLET_KEY=
LOG_LEVEL=info
REQUIRE_VC_FOR_CREATOR=false

# Optional: set SEED_PROFILE to override CLI flag (dev|test)
SEED_PROFILE=dev
