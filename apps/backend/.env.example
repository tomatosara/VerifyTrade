NODE_ENV=development
PORT=4000


# Verifier（驗證端）
VERIFIER_BASE=https://verifier-sandbox.wallet.gov.tw
VERIFIER_TOKEN=your_verifier_sandbox_access_token


# Issuer（發行端）
ISSUER_BASE=https://issuer-sandbox.wallet.gov.tw
ISSUER_TOKEN=your_issuer_sandbox_access_token


# DB / Redis
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/zkp?schema=public
REDIS_URL=redis://redis:6379


# 安全
RATE_LIMIT_PER_HOUR=3600
ALLOWED_ORIGINS=http://localhost:5173